############################################################################
################ all_use_all_profiles ######################################
# Display USE flags for profiles.
# $1 = mode: "all" (list all) or "select" (interactive select), or empty for all
all_use_all_profiles(){
	local mode="${1:-all}"
	local target profile_uses USEs
	if [[ "${mode}" == "select" ]];then
		if [[ ! -t 0 ]];then
			mode="all"
		else
			PS3=$(echo -e "${contrast}Choose number:${restore} ")
			select target in $(eselect --brief profile list);do
				profile_uses="$(profile "${PORTDIR}/profiles/${target}")"
				USEs="$(sort_passed_uses "${profile_uses}")"
				# shellcheck disable=SC1012
				echo -e "\n${green}${target}${restore}: "${USEs} | fold -s -w "${COLS}"
				unset USEs
				break
			done
			return 0
		fi
	fi
	for target in $(eselect --brief profile list);do
		profile_uses="$(profile "${PORTDIR}/profiles/${target}")"
		USEs="$(sort_passed_uses "${profile_uses}")"
		# shellcheck disable=SC1012
		echo -e "\n${green}${target}${restore}: "${USEs} | fold -s -w "${COLS}"
		unset USEs
	done
}
