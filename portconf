############################################################################
################ sort_passed_uses ##########################################
sort_passed_uses(){
	local uses="" opt
	for opt in ${1};do
		opt="${opt//\*/\\*}"
		if [[ -n "${uses// /}" ]];then
			uses="$(tr "[:space:]" $'\n' <<< "${uses}" | grep -v -e "^${opt#-}$" -e "^-${opt#-}$" | tr $'\n' " ")"
		fi
		uses+=" $(tr "[:space:]" $'\n' <<< "${1}" | grep -e "^${opt#-}$" -e "^-${opt#-}$" | tail -n1)"
	done
	echo "${uses}"
}
############################################################################
################ profile ###################################################
profile() {
	local use path _profile_visited
	[[ -f "${1}/make.defaults" ]] && use="$(. "${1}/make.defaults" 2>/dev/null; echo "$USE")" || use=""
	if [[ -f "${1}/parent" ]]; then
		_profile_visited="$(readlink -f "${1}")"
		for path in $(cat "${1}"/parent);do
			local _resolved
			_resolved="$(readlink -f "${1}/$path" 2>/dev/null)" || continue
			if ! grep -qxF "$_resolved" <<< "$_profile_visited"; then
				_profile_visited+="
$_resolved"
				use="$use $(profile "${1}/$path")"
			fi
		done
	fi
	echo "$use"
}

[[ -h "/etc/make.profile" ]] && pre_profile="$(profile "$(readlink -f "/etc/make.profile")")"
[[ -h "/etc/portage/make.profile" ]] && pre_profile="$(profile "$(readlink -f "/etc/portage/make.profile")")"
profile_uses="$(sort_passed_uses "${pre_profile}")"
