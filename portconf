		[[ -f "${package}" || -d "${package}" ]] || continue
		[[ "${package}" == *"~"* || "${package}" == *.bak || "${package}" == *.old ]] && continue
		incorrect="$(echo -e "${TRASH}" | tr $'\n' "%" | sed -e "s|.*${package}:||" -e 's|--.*||' -e 's|No.*||'|\
		tr "%" $'\n' | sed -e '/^$/d' | grep -v "${IGNORE}")"
		if [[ -n "${incorrect}" && -f "${package}" ]];then
			tmp_package="${TMPDIR_PORTCONF}/tmp_package"
			cp "${package}" "${tmp_package}"
			echo -e "${underline}Removing incorrect from${restore} ${contrast}${package}${restore}:"
			while IFS= read -r line;do
				echo -e "${red}Incorrect:${restore} ${line}"
				line="${line//'*'/\*}"
				[[ -n "${line}" ]] && sed -e "s|$line||" -e 's/[ \t]*$//' -e '/^$/d' -i "${tmp_package}" 2>/dev/null
			done <<< "${incorrect}"
			[[ -z "${NO_DIFF}" ]] && diff_ask "${package}" "${tmp_package}"
		elif [[ -n "${incorrect}" && -d "${package}" ]];then
			echo -e "${underline}Removing incorrect from${restore} ${contrast}${package}${restore}:"
			IFS=$'\n'
			for line in ${incorrect};do
				for file in $(grep -RH "${line//'*'/\*}" "${package}"/ | awk -F \: '{print $1}');do
					tmp_file="${TMPDIR_PORTCONF}/tmp_file"
					cp "${file}" "${tmp_file}"
					echo -e "${red}Incorrect:${restore} ${line}"
					[[ -n "${line}" ]] && sed -e "s|${line//'*'/\*}||" -e 's/[ \t]*$//' -e '/^$/d' -i "${tmp_file}"
					[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${tmp_file}"
				done
			done
			unset IFS
		fi
	done

	INVALID="$(LANG=en eix -Ttc 2>&1 | grep "Invalid.*\'.*\'" | grep -v '\.\.\.' | sort -u)"

	IFS=$'\n'
	for string in ${INVALID};do
		[[ -z "${string}" ]] && break
		file="$(awk -F ':' '{print $1}' <<< "${string}")"
		file="${file##* }"
		file="${file//[[:space:]]/}"

		line="$( awk -F ':' '{print $2}' <<< "${string}")"
		line="${line//\'/}"
		echo -e "${red}Incorrect:${restore} ${line}"
		line="${line//'*'/\*}"
		line="${line#[[:space:]]}"
		INVALID_FOUNDED+="${line}"$'\n'

		if [[ -n "${line}" && -f "${file}" ]];then
			tmp_file="${TMPDIR_PORTCONF}/tmp_file"
			cp "${file}" "${tmp_file}"
			[[ -n "${line}" ]] && sed -e "s|$(sed_escape "$line")$||" -e 's|[ \t]| |' -e '/^[ \t]$/d' -e '/^$/d' -i "${tmp_file}"
			[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${tmp_file}"
		elif [[ -n "${line}" && -d "${file}" ]];then
			for package in $(grep -RH "${line//'*'/\*}" "${file}"/ | awk -F \: '{print $1}');do
					tmp_package="${TMPDIR_PORTCONF}/tmp_package"
					cp "${package}" "${tmp_package}"
					echo -e "${red}Incorrect:${restore} ${line}"
					[[ -n "${line}" ]] && sed -e "s|${line//'*'/\*}||" -e 's/[ \t]*$//' -e '/^$/d' -i "${tmp_package}"
					[[ -z "${NO_DIFF}" ]] && diff_ask "${package}" "${tmp_package}"
			done
		fi
	done
	unset IFS

	##### don't quote it! #####
	if [[ -n "${INVALID_FOUNDED}" ]];then
		invalid=$(emerge --version 2>&1 | sed -e '/--- Invalid atom in /!d' -e 's|--- Invalid atom in ||g;s|:||' |\
			grep -v "${INVALID_FOUNDED}")
	else
		invalid=$(emerge --version 2>&1 | sed -e '/--- Invalid atom in /!d' -e 's|--- Invalid atom in ||g;s|:||')
	fi
	broken_files="$(awk '{print $1}' <<< "${invalid}" | sort -u)"
	if [[ -n "${invalid}" ]];then
		for bad_file in ${broken_files};do
			file_or_dir "${bad_file#${PORT_ETC}/}" "Founded invalid lines in" "invalid_lines"
		done
	fi
	unset invalid broken_files
}
############################################################################
################ profile's uses in make.conf ###############################
use_makeconf(){
	echo -e "${underline}Checking profile USE in${restore} ${contrast}${makefile##/etc*/}${restore}"

	# Build a set of profile flags for fast lookup
	declare -A profile_flags
	for flag in ${PROFILE};do
		profile_flags["${flag}"]=1
	done

	tmp_file="${TMPDIR_PORTCONF}/tmp_file"
	: > "${tmp_file}"
	local changed=0

	while IFS= read -r line;do
		if [[ "${line}" =~ ^([A-Za-z_]*USE)=\"([^\"]*)\" ]];then
			varname="${BASH_REMATCH[1]}"
			val="${BASH_REMATCH[2]}"
			new_val=""
			for flag in ${val};do
				if [[ -n "${profile_flags[${flag}]:-}" ]];then
					echo -e "Twice defined: ${red}${flag}${restore} in ${varname}"
					changed=1
				else
					new_val+=" ${flag}"
				fi
			done
			new_val="${new_val# }"
			echo "${varname}=\"${new_val}\"" >> "${tmp_file}"
		else
			echo "${line}" >> "${tmp_file}"
		fi
	done < "${makefile}"

	[[ "${changed}" -eq 1 && -z "${NO_DIFF}" ]] && diff_ask "${makefile}" "${tmp_file}"
	[[ "${changed}" -eq 0 ]] && rm -f "${tmp_file}"
}
############################################################################
################ find_and_remove ###########################################
# Find files matching expression and prompt to remove each.
# $1 = find expression (after -type f), $2 = optional check function name
# If $2 is set, the check function receives the target path and returns 0 to confirm removal
find_and_remove(){
	local find_expr="${1:-}"
	local check_fn="${2:-}"
	while IFS= read -r -d '' target;do
		if [[ -n "${check_fn}" ]];then
			CHECK_TARGET="${target}"
			${check_fn} && remove_ask "${target}"
		else
			remove_ask "${target}"
		fi
	done < <(eval "find \"${PORT_ETC}\" ${find_expr} -print0")
}
