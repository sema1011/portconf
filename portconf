############################################################################
################ parse_atom ################################################
# Parse qatom output: clean category/pn/ver/rev/slot
# Sets global: PARSED_CAT PARSED_PN PARSED_VER PARSED_REV PARSED_SLOT
parse_atom(){
	local cat="$1" pn="$2" ver="$3" rev="$4" slot="$5"
	local sw
	sw="$(grep -o "[<>=~]" <<< "${cat}" | tr -d $'\n')"
	cat="${cat##${sw}}"
	[[ "${cat}" == "(null)" || "${pn}" == "(null)" ]] && return 1
	[[ "${ver}" == "(null)" ]] && ver=""
	if [[ -n "${rev}" ]] && ! grep -q \: <<< "${rev}";then
		slot="${rev}"
		unset rev
	fi
	[[ -n "${rev}" && -z "${slot}" ]] && grep -q \: <<< "${rev}" && slot="${rev}"
	slot="${slot#:}"
	pn="${pn%:}"
	PARSED_CAT="${cat}"; PARSED_PN="${pn}"; PARSED_VER="${ver}"; PARSED_REV="${rev:-}"; PARSED_SLOT="${slot}"
	return 0
}
############################################################################
################ check_installed ###########################################
# Check if a package is installed.
# Args: $1=category $2=pn $3=ver $4=slot $5=defined_repo
# Sets global: IS_INSTALLED=0 or 1
	check_installed(){
	local cat="${1}" pn="${2}" ver="${3}" slot="${4}" defined_repo="${5}"
	local installed full_vers all_vers full_ver
	installed="$(qlist -ICSec "${cat}/${pn}" 2>/dev/null | awk '{print $2}')"
	if [[ -n "${installed}" ]];then
		if [[ -n "${defined_repo}" ]];then
			full_vers="$(qlist -ICev "${cat}/${pn}" 2>/dev/null | sed "s|${cat}/${pn}-||g")"
			(( "$(wc -l <<< "${full_vers}")" > 1 ))
			for full_ver in ${full_vers};do
				all_vers+=" ${PKGDB}/${cat}/${pn}-${full_ver}/repository"
			done
			if grep -qe "^${defined_repo}$" "${all_vers}" 2>/dev/null;then
				IS_INSTALLED=0
			else
				IS_INSTALLED=1
			fi
			unset all_vers
		else
			IS_INSTALLED=0
		fi
	else
		IS_INSTALLED=1
	fi
}
############################################################################
################ not_installed #############################################
not_if(){
	atoms="$(awk '{print $1}' <<< "$(awk '!/^#/' < "${package}")")"
	[[ -n "${IGNORE}" ]] && atoms="$(grep -v "${IGNORE}" <<< "${atoms}")"
	echo -e "${underline}Checking${restore} ${contrast}$package${restore}"
	if [[ -n "${atoms}" ]];then
		while IFS= read -r atom;do
			#::repo check
			if grep -q "::" <<< "${atom}";then
				defined_repo="${atom##*::}"
			else
				unset defined_repo
			fi
			[[ -n "${defined_repo}" ]] && atom="${atom%%::${defined_repo}}"
			while IFS= read -r category pn ver rev slot;do
				parse_atom "${category}" "${pn}" "${ver}" "${rev}" "${slot}" || continue
				check_installed "${PARSED_CAT}" "${PARSED_PN}" "${PARSED_VER}" "${PARSED_SLOT}" "${defined_repo}"
				if [[ "${IS_INSTALLED}" -eq 1 ]];then
					if [[ -n "${defined_repo}" ]];then
						echo -e "${red}Not installed${restore} ${green}${PARSED_CAT}/${PARSED_PN}::${underline}${defined_repo}${restore}"
					else
						echo -e "${red}Not installed${restore} ${green}${PARSED_CAT}/${PARSED_PN}${restore}"
					fi
					sed -e "s|.*\<${PARSED_CAT}/${PARSED_PN}\>.*||" -e '/^$/d' -i "${tmp_package}" 2>/dev/null
				fi
			done <<< "$(qatom "${atom}")"
		done <<< "${atoms}"
	fi
}

force_not_installed(){
	while IFS= read -r -d '' package;do
		if [[ -s "${package}" && -n "$(awk '!/^#/' < "${package}")" ]];then
			tmp_package="${TMPDIR_PORTCONF}/tmp_package"
			cp "${package}" "${tmp_package}"
			if ! grep -q "\.mask" <<< "${package}";then
				not_if;
			fi
			[[ -z "${NO_DIFF}" ]] && diff_ask "${package}" "${tmp_package}"
		else
			pack="${package%/*}"
			echo -e "${underline}Empty file${restore} ${contrast}${pack}${restore}"
			remove_ask "${package}"
		fi
	done < <(find "${PORT_ETC}"/package* -type f \! -name '*~' \! -name '*.bak' -print0)

	while IFS= read -r -d '' x;do
		if [[ ! -s "${x}" ]];then
			echo -e "${underline}Empty file${restore} ${contrast}${x}${restore}"
			remove_ask "${x}"
		fi
	done < <(find "${PORT_ETC}"/package* -type f -print0)
}
