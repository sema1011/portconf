############################################################################
################ restore ###################################################
restore(){
	[[ -d "${1}" ]] || { echo -e "${red}Directory ${1} not found${restore}"; return 1; }
	local tarballs
	tarballs="$(ls -1 --color=never "${1}"/*.bz2 2>/dev/null)"
	[[ -n "${tarballs}" ]] || { echo -e "${red}No backups in ${1}${restore}"; return 1; }
	tarballs="${tarballs//${1}\/}"
	tarballs="${tarballs//.tar.bz2/}"
	tarballs="${tarballs//${2}_/}"
	PS3=$(echo -e "${contrast}Choose number:${restore} ")
	echo -e "${contrast}Available backups${restore}:"
	# Non-interactive fallback: list and exit
	if [[ ! -t 0 ]];then
		select answer in ${tarballs};do
			[[ -n "${answer}" ]] && break
		done
		[[ -z "${answer}" ]] && { echo -e "${red}Aborted (non-interactive)${restore}"; return 1; }
	else
		select answer in ${tarballs};do
			[[ -n "${answer}" ]] && break
		done
	fi
	echo -e "Rolling back ${3} to the state ${green}${answer}${restore}"
	if [[ -n "${5}" ]];then
		# Prevent glob expansion: remove the glob pattern and use find instead
		case "${5}" in
			*\**|*\?*|*\[*)
				local _rm_targets
				_rm_targets="$(eval echo "${5}" 2>/dev/null)"
				for _rt in ${_rm_targets};do
					[[ -e "${_rt}" || -L "${_rt}" ]] && rm -rf "${_rt}"
				done
				;;
			*) rm -rf "${5}" ;;
		esac
	fi
	tar -xf "${1}/${2}_${answer}.tar.bz2" -C "${4}" 2>/dev/null
}
############################################################################
################ diff_ask ##################################################
diff_ask(){
	my_diff="$(diff "${1}" "${2}" | grep --color=never "[[:digit:]][a-z][[:digit:]]")"
	if [[ -n "${my_diff}" ]];then
		while IFS= read -r subj;do
			old_nums="$(tr ',' $'\n' <<< "${subj%[a-z]*}" | tr ' ' $'\n' | sed '/^$/d')"
			new_nums="$(tr ',' $'\n' <<< "${subj#*[a-z]}" | tr ' ' $'\n' | sed '/^$/d')"

			action="$(grep -o "[a-z]" <<< "${subj}")"
  			if [[ "${action}" == "a" ]];then
				for num in ${new_nums};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#+#${green}$(sed -n "${num}p" "${2}")${restore}#"$'\n'
				done
			elif [[ "${action}" == "d" ]];then
				for num in ${old_nums};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#-#${red}$(sed -n "${num}p" "${1}")${restore}#"$'\n'
				done
			elif [[ "${action}" == "c" ]];then
				for num in ${old_nums};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#-#${red}$(sed -n "${num}p" "${1}")${restore}#"$'\n'
				done
				for num in ${new_nums};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#+#${green}$(sed -n "${num}p" "${2}")${restore}#"$'\n'
				done
			fi
		done <<< "${my_diff}"
		echo -e "\n${contrast}Changes for ${green}${1}${restore}:${restore}"
		echo "###############################################"
		echo -e "${full_diff%\\n}" | column -s \^ -t
		echo "###############################################"
		if [[ -z "${yes}" && -z "${PRETEND}" ]];then
			if prompt_yesno "${contrast}Apply changes?${restore} ";then
				if [[ "${UID}" == "0" ]];then
					mv "${2}" "${1}" 2>/dev/null
					chmod 0644 "${1}"
				else
					echo -e "you are ${red}!root${restore} ---> go away!"
					unset full_diff
					return 0
				fi
			else
				rm "${2}" 2>/dev/null
			fi
			unset full_diff
			return 0
		elif [[ -n "${yes}" && -z "${PRETEND}" ]];then
			mv "${2}" "${1}" 2>/dev/null
			chmod 0644 "${1}"
			unset full_diff
			return 0
		elif [[ -z "${yes}" && -n "${PRETEND}" ]];then
			unset full_diff
			rm "${2}" 2>/dev/null
			return 0
		fi
	fi
	rm "${2}" 2>/dev/null
	return 0
}
############################################################################
################ remove_ask ################################################
remove_ask(){
	if [[ -z "${yes}" && -z "${PRETEND}" ]];then
		if prompt_yesno "${contrast}Remove${restore} ${green}${1}${restore}${contrast}?${restore} ";then
			rm -rf "${1}" 2>/dev/null
		fi
	elif [[ -n "${yes}" && -z "${PRETEND}" ]];then
		echo -e "${contrast}Removing${restore} ${green}${1}${restore}"
		rm -rf "${1}" 2>/dev/null
	elif [[ -z "${yes}" && -n "${PRETEND}" ]];then
		:
	fi
}
############################################################################
################ sort_packages #############################################
sort_uniq_files(){
	for package in $(find ${PORT_ETC}/ -type f \! -name '*~' \! -name '*.bak' | grep "/package\.");do
		tmp_sort="${TMPDIR_PORTCONF}/tmp_sort"
		echo -e "${underline}Sorting${restore} ${contrast}${package#${PORT_ETC}/}${restore}"

		all_atoms="$(awk '!/^#/ {print $1}' "${package}"| sort -u)"
		while IFS= read -r atom;do
			opts="$(grep "^${atom//\*/\\*} " "${package}" | uniq | cut -d" " -f2-)"
			echo "${atom} ${opts//$'\n'/ }" >> "${tmp_sort}"
		done <<< "${all_atoms}"

		sed -e '/^$/d' -e 's/[ \t]*$//' -i "${tmp_sort}"
		sort -u "${tmp_sort}" -o "${tmp_sort}" 2>/dev/null
		[[ -z "${NO_DIFF}" ]] && diff_ask "${package}" "${tmp_sort}"
	done
}
############################################################################
################ file or dir... ############################################
file_or_dir(){
	local founded
	for i in ${1};do
		founded+=" $(ls -d1 ${PORT_ETC}/"${i}" 2>/dev/null)"
	done
	if [[ -z "${founded}" ]];then
		echo -e "${underline}${2}${restore}${contrast}${PORT_ETC}/${1}${restore}: No such file or directory${restore}"
		return 1
	fi
	for target in ${founded};do
		if [[ -f "${target}" ]];then
			file="${target}"
			if [[ -s ${file} ]];then
				echo -e "${underline}${2}${restore} ${contrast}${file#${PORT_ETC}/}${restore}"
				${3};${4};${5};${6};${7};
			else
				echo -e "${underline}Empty file${restore} ${contrast}${file}${restore}"
				remove_ask "${file}"
			fi
		elif [[ -d "${target}" ]];then
			while IFS= read -r -d '' f;do
				file="${f}"
				if [[ -s ${file} ]];then
					echo -e "${underline}${2}${restore} ${contrast}${file#${PORT_ETC}/}${restore}"
					${3};${4};${5};${6};${7};
				else
					echo -e "${underline}Empty file${restore} ${contrast}${file}${restore}"
					remove_ask "${file}"
					continue
				fi
			done < <(find "${target}" -type f \! -name '*~' \! -name '*.bak' -print0)
		fi
	done
}
