############################################################################
################ env not_installed #########################################
env_not_installed(){
	echo -e "${underline}Looking not installed in${restore} ${contrast}${PORT_ETC}/env${restore}"
	for x in "env" "env.d";do
		[[ -d "${PORT_ETC}/${x}" ]] || continue
		files="$(find "${PORT_ETC}/${x}/" -mindepth 2 -maxdepth 2 -type f \! -name '*~' \! -name '*.bak' 2>/dev/null| cut -d/ -f5-)"
		[[ -n "${IGNORE}" ]] && files="$(grep -v "${IGNORE}" <<< "${files}")"
		dirs="$(find ${PORT_ETC}/${x}/ -type d 2>/dev/null)"
		[[ -n "${IGNORE}" ]] && dirs="$(grep -v "${IGNORE}" <<< "${dirs}")"
		[[ -n "${files}" || -n "${dirs}" ]] || break

		while IFS= read -r file;do
			atom="$(qatom "${file}")"
			atom="$(sed -e '/^$/d' <<< "${atom}")"
			while IFS= read -r category pn ver rev slot;do
				parse_atom "${category}" "${pn}" "${ver}" "${rev}" "${slot}" || continue
				if [[ -z "${PARSED_VER}" && -z "${PARSED_SLOT}" ]];then
					if ! ls -d1 ${PKGDB}/${PARSED_CAT}/${PARSED_PN}-[0-9]* &>/dev/null;then
						echo -e "${red}Not installed${restore} ${green}${PARSED_CAT}/${PARSED_PN}${restore}"
						RM+="${PORT_ETC}/${x}/${file}%"
					fi
				fi

				if [[ -n "${PARSED_VER}" && -z "${PARSED_SLOT}" ]] ;then
					full_ver="${PARSED_VER}"
					if [[ -n "${PARSED_REV}" && -n "${PARSED_REV}" ]];then
						full_ver="${PARSED_VER}-${PARSED_REV}"
					fi
					if ! ls -d1 ${PKGDB}/${PARSED_CAT}/${PARSED_PN}-${full_ver} &>/dev/null;then
						echo -e "${red}Not installed${restore} ${green}${PARSED_CAT}/${PARSED_PN}-${full_ver}${restore}"
						RM+="${PORT_ETC}/${x}/${file}%"
					fi
				fi

				if [[ -z "${PARSED_VER}" && -n "${PARSED_SLOT}" ]] ;then
					if [[ -z "$(cat ${PKGDB}/${PARSED_CAT}/${PARSED_PN}-[0-9]*/SLOT 2>/dev/null | grep "${PARSED_SLOT}")" ]];then
						echo -e "${red}Not installed${restore} ${green}${PARSED_CAT}/${PARSED_PN}:${PARSED_SLOT}${restore}"
						RM+="${PORT_ETC}/${x}/${file}%"
					fi
				fi
			done <<< "${atom}"
		done <<< "${files}"

		IFS="%"
		for target in ${RM%\%};do
			remove_ask "${target}"
		done
		IFS=$'\n'
		for target in ${dirs};do
			[[ -z "$(ls "${target}")" ]] && remove_ask "${target}"
		done
	unset IFS
	done
}
############################################################################
################ apply_use_replacement #####################################
# Apply USE flag replacement/removal in tmp_file for matching strings.
# $1 = mode: "remove" or "replace"
# For "remove": USE_TRASH holds the flag to remove (with optional -)
# For "replace": USE_FROM and USE_TO hold the flags
apply_use_replacement(){
	local mode="${1:-remove}"
	local _esc_src _esc_dst
	if [[ "${mode}" == "replace" ]];then
		_esc_src="$(sed_escape "${USE_FROM#-}")"
		_esc_dst="$(sed_escape "${USE_TO}")"
	else
		_esc_src="$(sed_escape "${USE_TRASH#-}")"
		_esc_dst=""
	fi
	while IFS= read -r string;do
		local struse usefxd strfxd
		struse="${string#${category}/${pn}}"
		struse="$(tr "[:space:]" $'\n' <<< "${struse}")"
		if [[ "${mode}" == "replace" ]];then
			usefxd="$(sed -e "s|^${_esc_src}$|${_esc_dst}|" -e "s|^\\-${_esc_src}$|\\-${_esc_dst}|" -e '/^$/d' <<< "${struse}")"
		else
			usefxd="$(sed -e "s|^${_esc_src}$||" -e "s|^\\-${_esc_src}$||" -e '/^$/d' <<< "${struse}")"
		fi
		usefxd="$(tr $'\n' " " <<< "${usefxd}")"
		usefxd="$(sed -e 's| - | |g' -e 's/[ -]*$//' <<< "${usefxd}")"
		strfxd="${category}/${pn} ${usefxd}"
		sed -e "s|^${category}/${pn}[[:space:]].*${_esc_src}.*$|${strfxd}|" -i "${tmp_file}" 2>/dev/null
	done <<< "${strings}"
}
############################################################################
################ check_uses ##############################################
check_uses(){
	echo -e "${underline}Checking use flags in${restore} ${contrast}${file#${PORT_ETC}/}${restore}:"
	##### eix env #####
	export OVERLAYS_LIST="no"
	export FORMAT='<availableversions:USEONLY>'
	export USEONLY=' <colliuse>'
	#### just count
	tput sc
	tput civis
	while IFS= read -r category pn ver slot;do
		tput el
		tput el1
		echo -ne "["; printf "% ${chars}d" $((count--));echo -ne " ]" "atoms left" 2>/dev/null
		tput rc

		ALL_USE=" $(eix -e "${category}/${pn}")" || continue
		ALL_USE="$(sed -e 's| +| |g;s| -| |g;s|(+)||g;s|(-)||g' <<< "${ALL_USE}" | tr "[:space:]" $'\n' | sort -u | sed -e '/^$/d')"
		LOCAL="$(grep "\<${category}/${pn}\> " "${file}" | cut -d" " -f2- | sed -e "s|#.*||g" | tr "[:space:]" $'\n' | sort -u)"
		USES="$(sed -e 's|^-||g' <<< "${LOCAL}")"
		for use in ${USES};do
			if ! grep -q "^${use}$" <<< "${ALL_USE}" && [[ "${use}" != "*" ]];then
				local dollar="$"
				for agrep_opt in 1 2 3 B;do
					for use_opt in "${use}" "^${use}" "${use}${dollar}" "^${use}${dollar}"; do
						similar_use="$(agrep -${agrep_opt} "${use_opt}" 2>/dev/null <<< "${ALL_USE}")"
						[[ -n "${similar_use}" ]] && (( $(wc -l <<< "${similar_use}") == 1 )) && break
					done
					[[ -n "${similar_use}" ]] && (( $(wc -l <<< "${similar_use}") == 1 )) && break
					[[ -z "${similar_use}" ]] || (( $(wc -l <<< "${similar_use}") > 1 )) && similar_use=""
				done
				if [[ -z "${similar_use}" ]];then
					grep -q " ${use}\>" <<< "${incorrect_use}" || incorrect_use="${incorrect_use} ${use}"
				else
					local _grep_pat
					_grep_pat="^${category}/${pn}[[:space:]].*\<${use}\>"
					strings="$(grep "$_grep_pat" "${tmp_file}")"
					echo -e "${category}/${pn}: ${red}${use} ---> ${green}${similar_use}${restore}"
					USE_FROM="${use}"; USE_TO="${similar_use}"; apply_use_replacement "replace"
					incorrect_use="${incorrect_use// ${similar_use}/}"
				fi
			else
				incorrect_use="${incorrect_use// ${use}/}"
			fi

			if grep -q "^${use}$" <<< "${GLOBAL}" && grep -q "^${use}$" <<< "${LOCAL}";then
				global_use="${global_use} ${use}"
			elif grep -q "^-${use}$" <<< "${GLOBAL}" && grep -q "^-${use}$" <<< "${LOCAL}";then
				global_use="${global_use} -${use}"
				incorrect_use="${incorrect_use// ${use}/}"
			fi
		done

		incorrect_use="$(echo "${incorrect_use}" | tr "[:space:]" $'\n' | sed -e 's|  | |g' -e '/^ $/d' -e '/^$/d' | sort -u)"
		global_use="$(echo "${global_use}" | tr "[:space:]" $'\n' | sed -e 's|  | |g' -e '/^ $/d' -e '/^$/d' | sort -u)"
		if [[ -n "${incorrect_use}" ]];then
			while IFS= read -r trash;do
				echo -e "Invalid use: ${green}${category}/${pn}${restore}: ${red}${trash}${restore}"
				local _grep_pat
				_grep_pat="^${category}/${pn}[[:space:]].*\<${trash}\>"
				strings="$(grep "$_grep_pat" "${tmp_file}")"
				USE_TRASH="${trash}"; apply_use_replacement "remove"
			done <<< "${incorrect_use}"
		fi
		if [[ -n "${global_use}" ]];then
			while IFS= read -r trash;do
				echo -e "Global  use: ${green}${category}/${pn}${restore}: ${red}${trash}${restore}"
				local _grep_pat
				_grep_pat="^${category}/${pn}[[:space:]].*\<${trash#-}\>"
				strings="$(grep "$_grep_pat" "${tmp_file}")"
				USE_TRASH="${trash}"; apply_use_replacement "remove"
			done <<< "${global_use}"
		fi
 	unset ALL_USE LOCAL USES incorrect_use global_use use
 	done <<< "$([[ -n "${atoms}" ]] && echo -e "${atoms}")"
 	while read -r atom opt;do
 		if [[ -n "${atom}" ]] && [[ -z "${opt}" ]];then
 			echo -e "Removing atom: ${green}${atom}${restore}"
 			sed -e "s|^${atom} *$||" -e '/^$/d' -i "${tmp_file}" 2>/dev/null
 		fi
 	done <<< "$(if [[ -n "${IGNORE}" ]]; then grep -v "${IGNORE}" < "${file}"; else cat "${file}"; fi)"
 	while read -r atom opt;do
 		if [[ -n "${atom}" ]] && [[ -z "${opt}" ]];then
 			echo -e "Removing atom: ${green}${atom}${restore}"
 			sed -e "s|^${atom} *$||" -e '/^$/d' -i "${tmp_file}" 2>/dev/null
 		fi
 	done <<< "$(if [[ -n "${IGNORE}" ]]; then grep -v "${IGNORE}" < "${tmp_file}"; else cat "${tmp_file}"; fi)"
 	unset FORMAT USEONLY
}
############################################################################
################ invalid_uses ##############################################
invalid_uses(){
	eix_check
	# If cache creation failed (no root), skip invalid USE check
	if [[ -z "${eix_cache}" || ! -f "${eix_cache}" ]];then
		echo -e "${red}eix cache unavailable (not root), skipping invalid USE check${restore}"
		return 0
	fi
	set -f
	FULL="${PROFILE} ${MAKE_USES}"
	for opt in ${FULL};do
		GLOBAL+=" $(echo "${FULL}" | tr "[:space:]" $'\n' | grep -e "^${opt#-}$" -e "^-${opt#-}$" | tail -n1)"
	done
	GLOBAL="$(echo "${GLOBAL}" | tr "[:space:]" $'\n' | sort -u)"
	if [[ -f "${PORT_ETC}/package.use" ]];then
		file="${PORT_ETC}/package.use"
		tmp_file="${TMPDIR_PORTCONF}/tmp_file"
		cp "${file}" "${tmp_file}"
		if [[ -n "${IGNORE}" ]];then
			content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g' | grep -v "${IGNORE}")"
			[[ -n "${content}" ]] && atoms="$(qatom "${content}")"
		else
			content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g')"
			[[ -n "${content}" ]] && atoms="$(qatom "${content}")"
		fi
		count="$(wc -l <<< "${atoms}")"
		((count--))
		chars="$(wc -m <<< "${count}")"
		check_uses
		tput el
		tput cnorm
		[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${tmp_file}"
		[[ ! -s "${file}" ]] && remove_ask "${file}"
	elif [[ -d "${PORT_ETC}/package.use" ]];then
		while IFS= read -r -d '' f;do
			if [[ -s "${f}" ]];then
				file="${f}"
				tmp_file="${TMPDIR_PORTCONF}/tmp_file"
				cp "${file}" "${tmp_file}"
				if [[ -n "${IGNORE}" ]];then
					content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g' | grep -v "${IGNORE}")"
					[[ -n "${content}" ]] && atoms="$(qatom "${content}")"
				else
					content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g')"
					[[ -n "${content}" ]] && atoms="$(qatom "${content}")"
				fi
				count="$(wc -l <<< "${atoms}")"
				((count--))
				chars="$(wc -m <<< "${count}")"
				check_uses
				tput cnorm
				[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${tmp_file}"
				[[ ! -s "${file}" ]] && remove_ask "${file}"
			else
				echo -e "${underline}Removing empty file${restore} ${contrast}${f}${restore}"
				rm "${f}" 2>/dev/null
				continue
			fi
		done < <(find "${PORT_ETC}/package.use/" -type f \! -name '*~' \! -name '*.bak' -print0)
	fi
	tput cnorm
	set +f
}
