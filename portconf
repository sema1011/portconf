############################################################################
slot_output(){
	if [[ "${mslot}" != "(null)" ]];then
		echo -e "${red}Incorrect${restore}: ${mcategory}/${mpn}:${mslot}"
	else
		echo -e "${red}Incorrect${restore}: ${mcategory}/${mpn}"
	fi
	TRASH+="${mfile} ${mcategory}/${mpn}"$'\n'
	unset msw mcategory mpn mver mrev mslot mfile usw ucategory upn uver urev uslot ufile
	_MASK_TRASH_SKIP=1
}
non_slot_output(){
	echo -e "${red}Incorrect${restore}: ${msw}${mcategory}/${mpn}-${mver}"
	TRASH+="${mfile} ${msw}${mcategory}/${mpn}-${mver}"$'\n'
	unset msw mcategory mpn mver mrev mslot mfile usw ucategory upn uver urev uslot ufile
	_MASK_TRASH_SKIP=1
}
############################################################################
mask_trash(){
	# Check eix cache exists before running eix queries
	if [[ -n "$(eix --version 2>/dev/null)" ]];then
		local _eix_cache
		_eix_cache="$(eix --print CACHEFILE 2>/dev/null)"
		[[ -z "${_eix_cache}" ]] && _eix_cache="/var/cache/eix/portage.eix"
		if [[ ! -f "${_eix_cache}" ]];then
			echo -e "${red}eix cache not found (${_eix_cache})${restore}"
			echo -e "Run ${contrast}eix-update${restore} as root or use ${contrast}-rc${restore} flag"
			return 1
		fi
	fi
	all_mask_trash || return 1
	###### m->masked; u->unmasked
	while IFS= read -r msw mcategory mpn mver mrev mslot mfile;do
		while IFS= read -r usw _ucategory _upn uver urev uslot _ufile;do
			_MASK_TRASH_SKIP=0
			[[ "${mrev}" == "(null)" ]] && unset mrev || mver="${mver}-${mrev}"
			[[ "${urev}" == "(null)" ]] && unset urev || uver="${uver}-${urev}"
			[[ "${mver}" == "(null)" ]] && unset mver
			[[ "${uver}" == "(null)" ]] && unset uver

			if [[ -n "${mver}" || -n "${uver}" ]];then
				export OVERLAYS_LIST="no"
				export VERSIONONLY='<version> '
				export FORMAT='<availableversions:VERSIONONLY>'
				versions="$(eix -e "${mcategory}/${mpn}")"
				oldest="$(awk '{print $1}' <<< "${versions}")"
			fi

			if [[ -n "${mver}" && -n "${uver}" ]];then
				versions_diff="$(version_compare "${mver}" "${uver}")"
				versions_btwn="$(version_compare "${uver}" "${mver}" "btwn" "${versions}")"
			fi

			if [[ "${msw}" != "(null)" ]];then
				if [[ "${usw}" == "(null)" && "${uslot}" == "(null)" ]];then
					non_slot_output
				elif [[ "${msw}" == ">" || "${msw}" == ">=" ]];then
					if [[ "${usw}" == ">" || "${usw}" == ">=" ]];then
						if [[ "${versions_diff}" != "1" && -z "${versions_btwn}" ]];then
							non_slot_output
						fi
					fi
				elif [[ "${msw}" == "<" || "${msw}" == "<=" ]];then
					if [[ "${usw}" == "<" || "${usw}" == "<=" ]];then
						if [[ "${versions_diff}" != "1" ]];then
							non_slot_output
						fi
					fi
				fi
			else
				if [[ "${mslot}" == "${uslot}" ]];then
					if [[ "${usw}" == ">=" || "${usw}" == ">" ]];then
						if [[ "$(version_compare "${uver}" "${oldest}")" != "1" ]];then
							slot_output
						fi
					elif [[ "${usw}" == "<"  && "$(version_compare "${uver}" "${oldest}")" == "1" ]];then
						slot_output
					elif [[ "${usw}" == "<=" && "$(version_compare "${uver}" "${oldest}")" != "1" ]];then
						slot_output
					elif [[ "${usw}" == "(null)" ]];then
						slot_output
					fi
				fi
			fi
			[[ "${_MASK_TRASH_SKIP}" -eq 1 ]] && continue
		done <<< "$(grep " ${mcategory} ${mpn} " <<< "${UNMASKED}")"
	done <<< "${MASKED}"

	files="$(awk '{print $1}' <<< "${TRASH}" | sort -u | sed '/^$/d')"
	for target in ${files};do
		if [[ -f "${target}" ]];then
			tmp_file="${TMPDIR_PORTCONF}/tmp_file"
			cp "${target}" "${tmp_file}"
			incorrect="$(grep -F "${target}" <<< "${TRASH}" | sed -e "s|$(sed_escape "${target}") ||g")"
			for trash_atom in ${incorrect};do
				sed -e "s|^$(sed_escape "${trash_atom}").*$||" -e '/^$/d' -e 's/[ \t]*$//' -i "${tmp_file}"
			done
			[[ -z "${NO_DIFF}" ]] && diff_ask "${target}" "${tmp_file}"
		fi
	done
	unset TRASH OVERLAYS_LIST VERSIONONLY FORMAT MASKED UNMASKED versions oldest versions_diff versions_btwn
}
############################################################################
################ looking trash #############################################
remove_trash(){
	tmp_file="${TMPDIR_PORTCONF}/tmp_file"
	cp "${file}" "${tmp_file}"
	for atom in $(eix -Tc#);do
		lines="$(grep -F "${atom}" "${file}" 2>/dev/null)"
		while IFS= read -r line;do
			entry="$(qatom "$(tr -d '<>=~#' <<< "${line}")" | awk '{print $1,$2}' | tr ' ' '/')"
			if [[ "${atom}" == "${entry}" ]];then
				if ! eix -qe --installed-masked "${entry}";then
					if eix -Iqe "${atom}" &>/dev/null;then
						echo -e "stupid entry:              ${green}${line}${restore}"
					else
						echo -e "stupid entry (${red}!${restore}installed): ${green}${line}${restore}"
					fi
					sed -e "s|$(sed_escape "${line}")||" -e '/^$/d' -i "${tmp_file}"
					break
				fi
			fi
		done <<< "${lines}"
	done
	[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${tmp_file}"
}
