############################################################################
################ create_backup #############################################
# Generic backup function with timestamp check and rotation.
# $1=backup_dir $2=source_path $3=tar_args $4=label_prefix
create_backup(){
	local backup_dir="${1}" source_path="${2}" tar_args="${3}" label="${4}"
	[[ -d "${backup_dir}" ]] || mkdir -p "${backup_dir}" 2>/dev/null
	[[ -d "${backup_dir}" ]] || { echo -e "${red}Cannot create ${backup_dir}${restore}"; return 1; }
	local tarballs oldest count
	tarballs="$(ls -1 --color=never "${backup_dir}")"
	oldest="$(head -n1 <<< "${tarballs}")"
	count="$(wc -l <<< "${tarballs}")"
	count="${count:-0}"
	local source_update backup_update
	source_update="$(timestamp "${source_path}")"
	backup_update="$(timestamp "${backup_dir}"/*)"
	backup_update="${backup_update:-0}"
	if (( source_update > backup_update ));then
		if (( count >= COUNT )) && [[ -n "${oldest}" ]];then
			rm "${backup_dir}/${oldest}"
		fi
		echo -e "${label} backup: ${green}creating${restore}..."
		local name
		name="${backup_dir}/${label}_$(date +%g.%m.%d-%H:%M).tar.bz2"
		tar -jcf "${name}" ${tar_args}
	else
		echo -e "${label} backups: ${green}already up-to-date${restore}"
	fi
}
