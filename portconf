	file_or_dir "package.unmask" "Preparing atoms in" "pre_unmask_trash" || return 1
}
pre_mask_trash(){
	masked="$(awk '!/^#/ {print $1}' ${file})"
	MASKED+="$(package_envs "${masked}")"$'\n'
}
pre_unmask_trash(){
	unmasked="$(awk '!/^#/ {print $1}' ${file})"
