################ backup ####################################################
backup(){
	local mc_flag=""
	[[ -f "/etc/make.conf" ]] && mc_flag=" make.conf"
	create_backup "${BRDIR}" "${PORT_ETC}" "-C /etc/ portage${mc_flag}" "/etc/portage"
}
