############################################################################
################ package.* files 2 dirs ####################################
convert_package_files(){
	local direction="${1:-f2d}"
	local package target
	while IFS= read -r package;do
		if [[ -f "${package}" ]];then
			if [[ "${direction}" == "f2d" ]];then
				echo -e "${underline}Processing${restore}: ${contrast}${package##*/}${restore}"
				local tmp_file="${TMPDIR_PORTCONF}/tmp_file"
				mv "${package}" "${tmp_file}" 2>/dev/null
				sed -e 's|^#.*||g' -i "${tmp_file}"
				local dir="${PORT_ETC}/${package##*/}"
				mkdir "${dir}"
				while IFS= read -r line;do
					set -f
					local atom category
					atom="$(awk '{print $1}' <<< "${line}")"
					category="$(awk '{print $1}' <<< "$(qatom "${atom}")")"
					if [[ "${category}" != "(null)" ]];then
						category="$(tr -d "<>=~" <<< "${category}")"
						[[ "${category}" == "*" ]] && category="all_categories"
						echo "${line}" >> "${dir}/${category}"
					fi
				done < "${tmp_file}"
				set +f
				rm "${tmp_file}" 2>/dev/null
			else
				echo -e "${underline}Skipping ${red}file${restore}: ${contrast}${package##*/}${restore}"
			fi
		elif [[ -d "${package}" ]];then
			if [[ "${direction}" == "d2f" ]];then
				echo -e "${underline}Processing${restore}: ${contrast}${package##*/}${restore}"
				local tmp_file="${TMPDIR_PORTCONF}/tmp_file"
				local file="${PORT_ETC}/${package##*/}"
				touch "${file}"
				: > "${tmp_file}"
				for subfile in $(find "${package}" -type f \! -name '*~' \! -name '*.bak' | sort);do
					while IFS= read -r line;do
						echo "${line}" >> "${tmp_file}"
					done < "${subfile}"
				done
				rm -rf "${package}" 2>/dev/null
				mv "${tmp_file}" "${package}" 2>/dev/null
				chmod 0644 "${package}"
				rm "${tmp_file}" 2>/dev/null
			else
				echo -e "${underline}Skipping ${red}directory${restore}: ${contrast}${package##*/}${restore}"
			fi
		fi
	done <<< "$(for p in "${PORT_ETC}"/package*; do [[ "${p}" != *'~' ]] && printf '%s\n' "$p"; done 2>/dev/null)"
}
############################################################################
################ version_compare ###########################################
# Compare versions: $1=ver_a $2=ver_b $3=mode (diff|btwn) $4=versions_list
# diff: returns 0=equal, 1=a>b, 2=b>a
# btwn: returns 1 if any version in $4 is between $1 and $2
version_compare(){
	local v1="${1}" v2="${2}" mode="${3:-diff}" list="${4:-}"
	if [[ "${mode}" == "btwn" ]];then
		for between in ${list};do
			local check1 check2
			check1="$(versionsort "${v1}" "${between}" 2>/dev/null | tail -n1)"
			check2="$(versionsort "${v2}" "${between}" 2>/dev/null | tail -n1)"
			if [[ "${check1}" == "${between}" && "${check2}" != "${between}" ]];then
				echo "1"
				break
			fi
		done
	else
		local check
		check="$(versionsort "${v1}" "${v2}" 2>/dev/null | tail -n1)"
		[[ "${check}" == "${v1}" && "${check}" != "${v2}" ]] && echo 1
		[[ "${check}" == "${v2}" && "${check}" != "${v1}" ]] && echo 2
		[[ "${check}" == "${v1}" && "${check}" == "${v2}" ]] && echo 0
	fi
}
############################################################################
package_envs(){
	for atom in ${1};do
		while IFS= read -r category pn ver rev slot;do
			sw="$(grep -o "[<>=~]" <<< "${category}" | tr -d $'\n')"
			category="${category##${sw}}"
			[[ "${category}" == "(null)" || "${pn}" == "(null)" ]] && continue
			if [[ -n "${rev}" && -z "${slot}" ]] && grep -q \: <<< "${rev}";then
				slot="${rev}"
				unset rev
			fi
			slot="${slot#:}"
			pn="${pn%:}"
			echo "${sw} ${category} ${pn} ${ver} ${rev:-(null)} ${slot:-(null)} ${file}"
		done <<< "$(qatom "${atom}")"
	done
}
