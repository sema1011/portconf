############################################################################
################ sort_uses #################################################
sort_uses(){
	tmp_file="${TMPDIR_PORTCONF}/tmp_file"
	striped="${TMPDIR_PORTCONF}/striped"
	PACKAGES="$(awk '!/^#/ {print $1}' ${file} | uniq)"
	for atom in ${PACKAGES};do
		comment="$(grep "${atom}[[:space:]].*#" "${file}" | cut -d\# -f2-)"
		for option in \
		$(grep "^${atom//\*/\\*}[[:space:]]" "${file}" | sed -e "s|${atom//\*/\\*} ||" -e "s|#.*${comment}||" | tr "[:space:]" $'\n' | uniq | tr $'\n' " ");do
			atom_opts+=" ${option}"
		done
		uses="$(sort_passed_uses "${atom_opts}")"
		uses="$(sed -e "s|^- | |g" -e "s| -- ||g" -e "s| - | |g" <<< "${uses}")"
		if [[ -n "${comment}" ]];then
			echo "${atom} ${uses} #${comment}" >> "${tmp_file}"
		else
			echo "${atom} ${uses}" >> "${tmp_file}"
		fi
		unset atom atom_opts option uses comment
	done
	cp "${tmp_file}" "${striped}" 2>/dev/null

	while IFS= read -r atom opt;do
		[[ -z "${opt}" ]] && sed -e "s|^${atom} ||" -i "${striped}" 2>/dev/null
		unset atom opt
	done < "${tmp_file}"
	sed -e 's/[ \t]*$//' -e '/^$/d' -e 's|  | |g' -e "s| - | |g" -i "${striped}" 2>/dev/null
	sort -u "${striped}" > "${tmp_file}" 2>/dev/null
	cp "${tmp_file}" "${striped}" 2>/dev/null
	rm "${tmp_file}" 2>/dev/null
	[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${striped}"
} 2>/dev/null
############################################################################
################ stupid_keyword ############################################
stupid_keywords(){
	local tmp_out="${TMPDIR_PORTCONF}/stupid_kw_out"
	cp "${2}" "${tmp_out}" 2>/dev/null
	unset ACCEPT_KEYWORDS
	local ACCEPT_KEYWORDS
	ACCEPT_KEYWORDS="$(eix --print ACCEPT_KEYWORDS | tr ' ' $'\n' | sort -u | tr $'\n' ' ')"
	for KEY in ${ACCEPT_KEYWORDS};do
		declare -A reported
		while IFS= read -r satom lkeys;do
			comment="$(cut -d\# -f2- <<< "${lkeys}")"
			lkeys="$(sed 's/  */ /g; s/^ //; s/ $//' <<< "${lkeys%%#*}")"
			out_keys="$(tr ' ' $'\n' <<< "${lkeys}" | sed '/^$/d')"
			#### wildcards
			pcategory="${satom%%/*}"
			pcategory="$(tr -d "<>=~" <<< "${pcategory}")"
			parent_keys="$(grep -e "${pcategory}/\*" -e "\*/\*" "${1}" | sed 's|^.* ||' | sort -u)"
			#### /wildcards
			if [[ "${satom}" != "${pcategory}/*" && "${satom}" != "*/*" ]];then
				for key in ${lkeys};do
					for pkey in ${parent_keys};do
						if [[ "${key}" == "${KEY}" || "${pkey}" == "${KEY}" ]];then
							if [[ -z "${reported[${satom}]:-}" ]];then
								echo -e "Twice defined keyword ${red}${key}${restore}:\t${green}${satom}${restore}"
								reported["${satom}"]=1
							fi
							out_keys="$(grep -vF "${key}" <<< "${out_keys}" | sed '/^$/d')"
						fi
					done
				done
			fi
			out_keys="$(tr $'\n' ' ' <<< "${out_keys}" | sed 's/  */ /g; s/^ //; s/ $//')"
			if [[ "${lkeys}" != "${out_keys}" ]];then
				if [[ -n "${out_keys}" ]];then
					local esc_satom
				esc_satom="$(sed_escape "${satom}")"
					if [[ -n "${comment}" ]];then
						string="$(grep "^${esc_satom} ${lkeys} .*#${comment}$" "${1}")"
						fixed_string="${satom} ${out_keys} #${comment}"
					else
						string="$(grep "^${esc_satom} ${lkeys}$" "${1}")"
						fixed_string="${satom} ${out_keys}"
					fi
				else
					string="$(grep "^${esc_satom} ${lkeys}.*$" "${1}")"
					fixed_string=""
				fi
				sed -e "s|^${string//\*/\\*}$|${fixed_string}|"  -e '/^$/d' -i "${tmp_out}" || { echo "fail 525"; exit 1; }
			fi
		done < "${1}"
		unset reported
	done
	# Clean all double spaces to prevent infinite loop
	sed -i 's/  */ /g; s/^ //; s/ $//' "${tmp_out}"
	cp "${tmp_out}" "${2}"
	rm -f "${tmp_out}"
}
############################################################################
################ sort_keys #################################################
sort_keys(){
	tmp_file="${TMPDIR_PORTCONF}/tmp_file"
	striped="${TMPDIR_PORTCONF}/striped"
	: > "${tmp_file}"

	# Determine atoms: filter comments and escape wildcards if sort mode, else raw
	if [[ "${SORT_KEYS_MODE}" == "last" ]];then
		atoms="$(awk '{print $1}' "${file}" | sort -u)"
	else
		atoms="$(awk '!/^#/ {print $1}' "${file}" | uniq)"
	fi

	for atom in ${atoms};do
		comment="$(grep "${atom}[[:space:]].*#" "${file}" | cut -d\# -f2-)"
		if [[ "${SORT_KEYS_MODE}" == "last" ]];then
			# Take last keyword (sort_keywords mode)
			keyword="$(grep "$(sed_escape "${atom}")[[:space:]]" "${file}" | sed -e "s|$(sed_escape "${atom}") ||" -e "s|#.*$(sed_escape "${comment}")||" | tr "[:space:]" $'\n' | sed '/^$/d' | tail -n1)"
			keyword="${keyword:-"~${ARCH}"}"
		else
			# Sort and deduplicate keywords (sort_keys mode)
			for option in \
			$(grep "^$(sed_escape "${atom//\*/\\*}")[[:space:]]" "${file}" | sed -e "s|$(sed_escape "${atom//\*/\\*}") ||" -e "s|#.*$(sed_escape "${comment}")||" | tr "[:space:]" $'\n' | uniq | tr $'\n' " ");do
				atom_opts+=" ${option}"
			done
			keyword="$(sort_passed_uses "${atom_opts}")"
			keyword="$(sed -e "s|^- | |g" -e "s| -- ||g" -e "s| - | |g" <<< "${keyword}")"
			keyword="${keyword:-"~${ARCH}"}"
			unset atom_opts
		fi
		if [[ -n "${comment}" ]];then
			echo "${atom} ${keyword} #${comment}" >> "${tmp_file}"
		else
			echo "${atom} ${keyword}" >> "${tmp_file}"
		fi
		unset atom keyword comment
	done

	cp "${tmp_file}" "${striped}" 2>/dev/null

	if [[ "${SORT_KEYS_MODE}" != "last" ]];then
		# Add ~ARCH to atoms without keywords (sort_keys mode only)
		while IFS= read -r atom opt;do
			[[ -z "${opt}" ]] && sed -e "s|^${atom}[ \t]$|${atom} ~${ARCH}|;s|^${atom}$|${atom} ~${ARCH}|" -i "${striped}" 2>/dev/null
			unset atom opt
		done < "${tmp_file}"
	fi

	sed -e 's/[ \t]*$//' -e '/^$/d' -e 's|  | |g' -e "s| - | |g" -i "${striped}" 2>/dev/null
	if [[ "${SORT_KEYS_MODE}" == "last" ]];then
		sort -u "${striped}" > "${tmp_file}" 2>/dev/null
		stupid_keywords "${file}" "${striped}"
		rm "${tmp_file}"
	else
		sort -u "${striped}" > "${tmp_file}" 2>/dev/null
		stupid_keywords "${tmp_file}" "${striped}"
		rm "${tmp_file}" 2>/dev/null
	fi
	[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${striped}"
} #2>/dev/null
