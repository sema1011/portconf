############################################################################
################ sed_escape ##################################################
sed_escape(){
	# Escape sed BRE metacharacters: & \ and regex metacharacters
	# Note: * must be escaped as [*] because \* in BRE means "0+ previous"
	# { } | are NOT BRE metacharacters (only with \ prefix in BRE)
	# / is NOT escaped because sed uses | as delimiter throughout
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//&/\\&}"
	s="${s//$'\n'/\\n}"
	s="${s//\[/\\[}"
	s="${s//\]/\\]}"
	s="${s//\^/\\^}"
	s="${s//\$/\\$}"
	s="${s//\./\\.}"
	s="${s//\*/[*]}"
	s="${s//\?/\\?}"
	s="${s//\(/\\(}"
	s="${s//\)/\\)}"
	echo "$s"
}
############################################################################
################ temp directory ##########################################
TMPDIR_PORTCONF="$(mktemp -d)"
############################################################################
################ prompt_yesno ##############################################
# Prompt user with Yes/No question. Returns 0 for yes (or empty=accept), 1 for no.
# Usage: if prompt_yesno "Question?"; then ...; fi
prompt_yesno(){
	echo -ne "${1} [${green}Yes${restore}/${red}No${restore}] " <&2
	while IFS= read -r x <&3;do
		case ${x} in
			Yes | YES | yes | Y | y | "" ) return 0;;
			No | NO | no | N | n ) return 1;;
			* ) echo -ne "Sorry, response '${x}' not understood. [${green}Yes${restore}/${red}No${restore}] " <&2
				continue;;
		esac
	done 3< /dev/tty
}
############################################################################
################ rm_comments_check #########################################
# Check and remove comments from package files.
# $1 = mode: "leading" (only leading #) or "all" (all inline #)
rm_comments_check(){
	local tmp_file="${TMPDIR_PORTCONF}/tmp_file"
	cp "${file}" "${tmp_file}"
	if [[ "${RC_MODE}" == "all" ]];then
		sed -e "s|#.*||g" -e 's/[ \t]*$//' -e '/^$/d' -i "${tmp_file}"
	else
		sed -e "s|^#.*||g" -e '/^$/d' -i "${tmp_file}"
	fi
	[[ -z "${NO_DIFF}" ]] && diff_ask "${file}" "${tmp_file}"
}
############################################################################
################ timestamp #################################################
timestamp(){
	stat -c %Y "$@" 2>/dev/null | sort | tail -n1
}
############################################################################
################ eix check #################################################
eix_check(){
	if [[ -n "${EIX_CACHE_CREATED:-}" ]];then
		return 0
	fi
	if [[ -n "$(eix --version 2>/dev/null)" ]];then
		# Use system eix cache
		eix_cache="$(eix --print CACHEFILE 2>/dev/null)"
		if [[ -z "${eix_cache}" || ! -f "${eix_cache}" ]];then
			eix_cache="/var/cache/eix/portage.eix"
		fi
		if [[ -f "${eix_cache}" ]];then
			export EIX_CACHEFILE="${eix_cache}"
		else
			# Cache doesn't exist — try to create it, or skip
			if [[ "${UID}" -eq 0 ]];then
				echo -e "${underline}Creating eix cache...${restore}"
				eix-update 2>/dev/null
				if [[ -f "${eix_cache}" ]];then
					export EIX_CACHEFILE="${eix_cache}"
				else
					eix_cache=""
					echo -e "${red}Failed to create eix cache, skipping eix-dependent checks${restore}"
				fi
			else
				eix_cache=""
				echo -e "${red}eix cache not found, run as root or run 'eix-update'${restore}"
			fi
		fi
		EIX_CACHE_CREATED="1"
	else
		echo -e "${green}app-portage/eix${restore} ${red}not installed!${restore}"
		exit 1
	fi
}
############################################################################
################ eix check method ##########################################
eix_method(){
	if [[ -n "$(eix --version 2>/dev/null)" ]];then
		if [[ "$(eix --print OVERLAY_CACHE_METHOD)" != "parse|ebuild*" ]];then
			[[ -n "${yes}" ]] && eix_check
			echo -ne "\n${red}!default 'OVERLAY_CACHE_METHOD'${restore}${contrast}
Create temporary cache?${restore} "
			if prompt_yesno "";then
				eix_check
			fi
		fi
	else
		echo -e "${green}app-portage/eix${restore} ${red}not installed!${restore}"
		exit 1
	fi
}
